# bullpen-rs environment (meridian: /home/bullpen/bullpen-rs.env)
# Mode 600, owner bullpen. Copy to the server; never commit real values.
# systemd: EnvironmentFile= in deploy/bullpen-rs.service (overrides inline Environment=).

# --- OpenRouter (required for model calls) ---
# BULLPEN_OPENROUTER_KEY_FILE=/home/bullpen/.bullpen/openrouter.key
# BULLPEN_OPENROUTER_KEY=            # inline fallback if no file (discouraged on meridian)

# --- TypeSafe / Jev (optional: helper-kind gate, repo_grep re-rank) ---
# BULLPEN_TYPESAFE_KEY_FILE=/home/bullpen/.bullpen/typesafe.key
# BULLPEN_TYPESAFE_KEY=

# --- Settings-table encryption (Stripe, Slack tokens, etc.) ---
# BULLPEN_SETTINGS_KEY_FILE=/home/bullpen/.bullpen/settings.key
# BULLPEN_SETTINGS_KEY=

# --- Public URL (OAuth redirects, Slack Events URL, webhooks) ---
# PUBLIC_URL=https://rainmade.io/bullpen

# --- Share links (bot export tokens); set a long random value in prod ---
# BULLPEN_SHARE_SECRET=

# --- Data + listen (usually set in unit file; env file must NOT point at live TS data) ---
# BULLPEN_DATA_DIR=/home/bullpen/bullpen-rs
# BULLPEN_PORT=4380
# BULLPEN_HOST=0.0.0.0
# BULLPEN_CLIENT_ROOT=/home/bullpen/bullpen-rs/client

# --- Sandbox / VM / computer use (meridian: on) ---
# BULLPEN_SANDBOX=on
# BULLPEN_VM=on
# BULLPEN_SANDBOX_EGRESS=            # when set, enables controlled egress path
# BULLPEN_SANDBOX_NETWORK=bullpen-egress
# DOCKER_HOST=unix:///run/user/1004/docker.sock
# XDG_RUNTIME_DIR=/run/user/1004
# BULLPEN_SSH_KEY=/home/bullpen/.ssh/id_ed25519

# --- propose_tool / W5 (ships with release tarball optional w5/) ---
# BULLPEN_NIGHT_ROOT=/home/bullpen/bullpen-night
# BULLPEN_W5_SCRIPT=

# --- Marketplace bot directory (optional remote template source) ---
# BULLPEN_BOT_DIRECTORY_URL=

# --- Apple Push Notification service (S13; placeholders until keys exist) ---
# BULLPEN_APNS_KEY_FILE=/home/bullpen/.bullpen/apns.p8
# BULLPEN_APNS_KEY_ID=
# BULLPEN_APNS_TEAM_ID=

# --- Logging ---
# RUST_LOG=info,server=debug,model=debug,bullpen=debug

# --- Teams webhook stub (501 unless enabled) ---
# BULLPEN_TEAMS=

# --- Dev / test only (never on meridian prod) ---
# BULLPEN_FAKE_PORT=
# BULLPEN_FAKE_CREDITS=

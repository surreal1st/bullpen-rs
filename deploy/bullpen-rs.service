[Unit]
Description=Bullpen-rs by Rainmade
Documentation=https://github.com/rainmade/bullpen-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bullpen
Group=bullpen
WorkingDirectory=/home/bullpen/bullpen-rs
ExecStart=/home/bullpen/bullpen-rs/bullpen
Environment=BULLPEN_PORT=4380
# 0.0.0.0 like live: the desktop app reaches it over LAN/tailnet, not nginx.
Environment=BULLPEN_HOST=0.0.0.0
Environment=BULLPEN_DATA_DIR=/home/bullpen/bullpen-rs
Environment=BULLPEN_CLIENT_ROOT=/home/bullpen/bullpen-rs/client
# S10-09/10: `propose_tool` shells out to W5 (`w5/run.mjs`) against bullpen-night's
# `bot-tools.ts`. Without this, the server uses a compile-time path from the build
# machine (workstation WSL), which does not exist on meridian. Checkout lives under
# `/home/bullpen/` so `ProtectHome=read-only` + `ReadWritePaths=/home/bullpen` still
# cover it; `ship.sh` does not ship the TS tree (only binary, client, templates, w5/).
Environment=BULLPEN_NIGHT_ROOT=/home/bullpen/bullpen-night
# The sandbox daemon is bullpen's OWN rootless Docker, never the host one.
Environment=XDG_RUNTIME_DIR=/run/user/1004
Environment=DOCKER_HOST=unix:///run/user/1004/docker.sock
# The ssh tool is OFF unless this points at a real key. Provisioned 2026-09-11:
# an ed25519 keypair owned by bullpen, authorized for rainmade on this host, so
# a bot can reach the files and services meridian hosts.
Environment=BULLPEN_SSH_KEY=/home/bullpen/.ssh/id_ed25519
Environment=BULLPEN_SANDBOX=on
# S8c: per-bot machines. THIS LINE IS WHAT MAKES COMPUTER USE EXIST - `browse`,
# `read_page`, `click`, `type_text` and `desk_shell` all resolve through
# `vms_enabled()` (`lib.rs:629`), which reads this and defaults to OFF. With it
# unset every one of them refuses with "Per-bot machines are off here" and the
# gate stays green the whole time, because nothing in the test suite reads the
# real env var.
#
# 🔴 It was missing here until 2026-09-17 and the running service had it only
# from the EnvironmentFile below - so a rebuild from this repo would have
# produced a server with every computer-use tool silently dead. Tracked here as
# the default; the env file still wins if it sets it too (see the ordering note
# below), which is how the box has it today.
Environment=BULLPEN_VM=on
# S8b: without this the server is SILENT. `tracing` emits nothing by default,
# so `journalctl -u bullpen-rs` showed only systemd's own start/stop lines -
# no "listening", no errors, nothing. Two consequences, both measured on
# 2026-09-16: the VM reaper's start could not be confirmed from the box at all
# (it had to be proven from container state and the `vms` table), and ~9% of
# chat runs were finishing with no text, no tokens and no error, with no
# record anywhere of whether the model was ever called. A server that
# discards its own evidence cannot be diagnosed, only guessed at.
#
# `info` for the tree, `debug` for our own crates: the model port logs one
# line per response and one summary per stream, which is the pair that makes
# an empty run readable after the fact.
Environment=RUST_LOG=info,server=debug,model=debug,bullpen=debug
# Secrets live here, mode 600, owned by bullpen. Never in the repo, never in a
# unit file, never on a command line.
# 🔴 Its OWN file, never live's bullpen.env: an EnvironmentFile overrides Environment=
# lines, and live's sets BULLPEN_DATA_DIR=/home/bullpen/data, which would point this
# service at the LIVE database.
#
# What bullpen-rs.env actually holds, read off the box 2026-09-17 (names only -
# never the values): BULLPEN_OPENROUTER_KEY_FILE, BULLPEN_SANDBOX, BULLPEN_VM,
# PUBLIC_URL. Optional since S9-JEV (same file, same rules as OpenRouter):
# BULLPEN_TYPESAFE_KEY_FILE or BULLPEN_TYPESAFE_KEY — when unset, helper-kind
# gate and repo_grep re-rank stay off (no Jev HTTP). The old comment here claimed it held only the key file, which was
# wrong, and the two it did not mention were exactly the two that never made it
# into this tracked file. Only the key-file path genuinely needs to live outside
# the repo; the other three are plain operational settings, so BULLPEN_SANDBOX
# and BULLPEN_VM are now ALSO set above, where a reader can see them.
#
# PUBLIC_URL stays out of this file on purpose: it is the host's own external
# URL, which belongs to the deployment, not to the program. It must be set
# wherever this unit is installed.
EnvironmentFile=/home/bullpen/bullpen-rs.env
Restart=on-failure
RestartSec=2

# Hard ceilings. meridian has 62 GB and has already lost every service once to a
# single process taking 59.7 GB of it. Bullpen must never be that process.
MemoryMax=2G
MemoryHigh=1500M
MemorySwapMax=0
CPUQuota=200%
TasksMax=512

# Hardening. The app writes only under its own home.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/bullpen
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
